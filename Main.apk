<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🔥 Apex Mod | PUBG Mobile</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: #0b0b12;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            background: radial-gradient(circle at 20% 30%, #141425, #07070e);
            overflow-x: hidden;
        }
        body::before {
            content: '';
            position: fixed;
            top: -30%;
            left: -20%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(0, 180, 255, 0.15), transparent 70%);
            border-radius: 50%;
            z-index: 0;
            animation: floatOrb 12s infinite alternate ease-in-out;
        }
        body::after {
            content: '';
            position: fixed;
            bottom: -30%;
            right: -20%;
            width: 700px;
            height: 700px;
            background: radial-gradient(circle, rgba(255, 0, 100, 0.10), transparent 70%);
            border-radius: 50%;
            z-index: 0;
            animation: floatOrb 15s infinite alternate-reverse ease-in-out;
        }
        @keyframes floatOrb {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(40px, 40px) scale(1.2); }
        }
        .card {
            position: relative;
            z-index: 1;
            background: rgba(18, 20, 35, 0.65);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 48px;
            padding: 60px 50px;
            max-width: 620px;
            width: 100%;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.05);
            transition: transform 0.3s ease;
            text-align: center;
        }
        .card:hover { transform: translateY(-4px); }
        .badge {
            display: inline-block;
            background: linear-gradient(135deg, #00c6ff, #0072ff);
            padding: 6px 18px;
            border-radius: 100px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #fff;
            margin-bottom: 24px;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }
        .title {
            font-size: 42px;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 10px;
            background: linear-gradient(to right, #ffffff, #a0c4ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .subtitle {
            color: rgba(255, 255, 255, 0.5);
            font-weight: 400;
            font-size: 16px;
            letter-spacing: 1px;
            margin-bottom: 30px;
        }
        .features {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
            margin-bottom: 40px;
        }
        .feature-item {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.06);
            padding: 10px 20px;
            border-radius: 60px;
            font-size: 14px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(4px);
            transition: all 0.2s ease;
            letter-spacing: 0.3px;
        }
        .feature-item:hover {
            background: rgba(0, 180, 255, 0.1);
            border-color: rgba(0, 180, 255, 0.3);
            transform: scale(1.02);
        }
        .feature-item .icon { margin-right: 8px; }

        /* ========== TRICKED BUTTON ========== */
        .download-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            background: linear-gradient(135deg, #0072ff, #00c6ff);
            padding: 18px 50px;
            border: none;
            border-radius: 80px;
            font-size: 20px;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.25s ease;
            box-shadow: 0 8px 30px rgba(0, 114, 255, 0.35);
            letter-spacing: 0.5px;
            width: 100%;
            max-width: 340px;
            margin: 0 auto 18px auto;
        }
        .download-btn:hover {
            transform: scale(1.03);
            box-shadow: 0 12px 40px rgba(0, 114, 255, 0.55);
            background: linear-gradient(135deg, #0088ff, #00d4ff);
        }
        .download-btn:active { transform: scale(0.97); }
        .download-btn .pulse {
            display: inline-block;
            width: 12px;
            height: 12px;
            background: #ffffff;
            border-radius: 50%;
            margin-right: 6px;
            animation: pulseDot 1.8s infinite;
        }
        @keyframes pulseDot {
            0% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.3; transform: scale(1.6); }
            100% { opacity: 1; transform: scale(1); }
        }
        .file-info {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.3);
            margin-bottom: 35px;
            font-weight: 300;
        }

        .warning-box {
            background: rgba(255, 50, 50, 0.06);
            border-left: 3px solid #ff4d4d;
            border-radius: 12px;
            padding: 18px 20px;
            margin-top: 20px;
            text-align: left;
        }
        .warning-box p {
            color: rgba(255, 150, 150, 0.8);
            font-size: 13px;
            font-weight: 400;
            line-height: 1.6;
            margin: 0;
        }
        .warning-box strong { color: #ff7a7a; }
        .footer {
            margin-top: 30px;
            color: rgba(255, 255, 255, 0.15);
            font-size: 12px;
            font-weight: 300;
            letter-spacing: 0.5px;
        }
        @media (max-width: 500px) {
            .card { padding: 40px 24px; border-radius: 32px; }
            .title { font-size: 30px; }
            .features { gap: 8px; }
            .feature-item { font-size: 12px; padding: 8px 14px; }
            .download-btn { font-size: 17px; padding: 16px 30px; max-width: 100%; }
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="badge">🚀 Latest Version v4.6</div>
        <h1 class="title">Apex Mod</h1>
        <p class="subtitle">PUBG MOBILE · Premium Unlocked</p>

        <div class="features">
            <span class="feature-item"><span class="icon">🎯</span> Aimbot</span>
            <span class="feature-item"><span class="icon">👁️</span> ESP Boxes</span>
            <span class="feature-item"><span class="icon">📡</span> Radar Hack</span>
            <span class="feature-item"><span class="icon">🔫</span> No Recoil</span>
            <span class="feature-item"><span class="icon">🛡️</span> Anti-Ban</span>
        </div>

        <!-- ========== THE TRAP: Links to troll.html ========== -->
        <a href="troll.html" class="download-btn" target="_blank" rel="noopener">
            <span class="pulse"></span> 
            Download APK
        </a>
        <div class="file-info">📦 198 MB · Compatible with Android 8.0+</div>

        <div class="warning-box">
            <p>
                <strong>⚠️ ACCOUNT WARNING:</strong> 
                Using modified versions of PUBG Mobile violates Tencent's Terms of Service. 
                Your account <strong>will be permanently banned</strong> if detected. 
                Use only on <strong>alternative / guest accounts</strong> at your own risk.
            </p>
        </div>
        <div class="footer">For educational & testing purposes only.</div>
    </div>

    <script>
        // ========== SUPREME TROLL ==========
        // When they click the button, we show a fake "Downloading" alert 
        // before sending them to the troll panel.
        document.querySelector('.download-btn').addEventListener('click', function(e) {
            // Optional: Show a toast/alert to make it look like it's loading
            // We won't prevent default, we just let it open troll.html
            // But let's add a sneaky vibration if the phone supports it
            if (navigator.vibrate) {
                navigator.vibrate(200);
            }
            // Let the link open normally, but we can log it
            console.log('Victim clicked download... redirecting to troll panel.');
        });
    </script>
</body>
</html>
